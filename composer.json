{
    "name": "mediadev/monitor",
    "description": "Framework open source para monitorear múltiples sitios WordPress desde un solo dashboard",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "MediadevMonitor\\": "src/"
        }
    },
    "bin": [
        "bin/mediadev",
        "bin/collector.php"
    ]
}
