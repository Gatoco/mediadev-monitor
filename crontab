# Mediadev Monitor — cron
# Una sola entrada: Laravel Scheduler decide la cadencia
# (uptime cada 5 min, deep cada 6h — routes/console.php).
# Nota: cron usa PATH mínimo (/usr/bin:/bin) — ruta absoluta a php.
* * * * * cd /app/laravel && /usr/local/bin/php artisan schedule:run >> /var/log/mediadev-scheduler.log 2>&1
