#!/usr/bin/env php
<?php

/**
 * Mediadev Monitor — CLI principal.
 *
 * Uso:
 *   bin/mediadev check all          # monitorear todos los sitios
 *   bin/mediadev check <url>        # monitorear un sitio específico
 *   bin/mediadev list               # listar sitios registrados
 *
 * Exit codes: 0 = OK, 1 = sitios caídos/críticos, 2 = error de uso/config
 */

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use MediadevMonitor\Cli\Reporter;
use MediadevMonitor\Collector\CollectionReport;
use MediadevMonitor\Collector\Collector;
use MediadevMonitor\Infra\Config;
use MediadevMonitor\SiteRegistry\SiteRegistry;

$args = $argv;
array_shift($args); // bin/mediadev

$command = $args[0] ?? 'help';

$config = new Config();

switch ($command) {
    case 'check':
        $target = $args[1] ?? null;
        $collector = new Collector($config);

        if ($target === null || $target === 'all') {
            $report = $collector->runAll('deep');
        } else {
            $registry = new SiteRegistry($config);
            $site = $registry->findByUrl($target);
            if ($site === null) {
                fwrite(STDERR, "Sitio no encontrado: $target\n");
                exit(2);
            }
            $siteReport = $collector->runOne($site);
            $report = new CollectionReport([$siteReport]);
        }

        echo (new Reporter())->render($report);
        exit($report->hasCritical() ? 1 : 0);

    case 'list':
        $registry = new SiteRegistry($config);
        $sites = $registry->all();
        foreach ($sites as $site) {
            printf("%-4d %-40s %-8s\n", $site->id, $site->url, $site->type);
        }
        exit(0);

    case 'help':
    default:
        echo "Mediadev Monitor\n\n";
        echo "Uso:\n";
        echo "  bin/mediadev check all          monitorear todos los sitios\n";
        echo "  bin/mediadev check <url>        monitorear un sitio específico\n";
        echo "  bin/mediadev list               listar sitios registrados\n";
        exit($command === 'help' ? 0 : 2);
}
