#!/usr/bin/env bash
# mediadev-feria — levanta el stack y abre SemaOPS Mission Control (/live) en pantalla completa.
#   mediadev-feria            construye/levanta y abre el kiosko
#   mediadev-feria --no-build usa la imagen existente (más rápido)
#   mediadev-feria --share    además publica el panel en la IP Tailscale (para verlo desde otro equipo)
#   mediadev-feria --stop     detiene el monitor
#   mediadev-feria --remote   sólo abre el kiosko apuntando al monitor de otro equipo (FERIA_HOST, por defecto el T420)
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
URL="${FERIA_URL:-http://127.0.0.1:8080/live}"
cd "$ROOT"
COMPOSE=(docker compose)

case "${1:-}" in
  --remote) URL="${FERIA_URL:-http://${FERIA_HOST:-100.66.97.18}:8080/live}" ;;
  --stop) docker compose stop monitor; exit 0 ;;
  --share)
    export TS_IP="$(tailscale ip -4 | head -1)"
    COMPOSE=(docker compose -f docker-compose.yml -f docker-compose.tailscale.yml)
    "${COMPOSE[@]}" up -d monitor ;;
  --no-build) docker compose up -d monitor ;;
  *)
    # compose build no puede pasar --allow; el Dockerfile usa network: host (ver docker-compose.yml)
    docker compose build --print monitor | docker buildx bake --allow=network.host -f - --load monitor
    docker compose up -d monitor ;;
esac

printf 'Esperando %s ' "$URL"
for _ in $(seq 1 60); do
  curl -fs -o /dev/null "$URL" && break
  printf '.'; sleep 2
done
curl -fs -o /dev/null "$URL" || { echo; echo "El panel no respondió en 2 min: docker compose logs monitor" >&2; exit 1; }
echo ' listo'

for b in chromium chromium-browser google-chrome-stable brave firefox; do
  command -v "$b" >/dev/null || continue
  case "$b" in
    firefox) exec firefox --kiosk "$URL" ;;
    *) exec "$b" --kiosk ${WAYLAND_DISPLAY:+--ozone-platform=wayland} --noerrdialogs --disable-infobars --user-data-dir="${TMPDIR:-/tmp}/mediadev-feria-profile" "$URL" ;;
  esac
done
echo "Sin navegador compatible; abre $URL" >&2
